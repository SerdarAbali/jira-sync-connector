{
  "name": "jira-sync-connector",
  "version": "2.2.1",
  "description": "SyncApp: Atlassian Forge app for real-time two-way (bidirectional) synchronization between two Jira Cloud organizations",
  "main": "src/index.js",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/SerdarAbali/jira-sync-connector.git"
  },
  "scripts": {
    "deploy": "forge deploy",
    "forge:install": "forge install",
    "tunnel": "forge tunnel",
    "logs": "forge logs --tail",
    "lint": "eslint src/",
    "test": "jest",
    "check:secrets": "node scripts/check-secrets.js",
    "check:forge": "forge lint",
    "check:forge:offline": "node scripts/check-forge-offline.js",
    "test:guarantees": "jest --runInBand --runTestsByPath tests/package1-outbound-scope.test.js tests/package1-outbound-guarantee.test.js",
    "test:staging": "jest --runInBand --runTestsByPath tests/staging-preflight.test.js",
    "test:staging:e2e": "jest --runInBand --runTestsByPath tests/staging-e2e-runner.test.js tests/staging-e2e-cli.test.js",
    "staging:preflight": "node scripts/staging/preflight.js",
    "staging:report": "node scripts/staging/report.js",
    "staging:e2e:plan": "node scripts/staging/e2e.js --plan",
    "staging:e2e:dry-run": "node scripts/staging/e2e.js --dry-run",
    "staging:e2e": "node scripts/staging/e2e.js",
    "check:neutrality": "node scripts/check-neutrality.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@babel/preset-env": "^7.28.5",
    "@forge/cli": "14.2.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "babel-jest": "^30.2.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "playwright-core": "1.64.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "semantic-release": "^25.0.9"
  },
  "dependencies": {
    "@forge/api": "8.1.0",
    "@forge/events": "3.0.6",
    "@forge/kvs": "2.0.6",
    "@forge/resolver": "2.0.0"
  }
}
