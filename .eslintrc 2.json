{
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "extends": ["eslint:recommended"],
  "rules": {
    "no-unused-vars": ["warn", { "args": "none", "ignoreRestSiblings": true }]
  },
  "ignorePatterns": ["node_modules/", "static/", "tests/", "scripts/", "check-mapping.js", "check-storage.js"]
}
